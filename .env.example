# BookSwap Server Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=bookswap_super_secret_jwt_key_2026

# MySQL 8.0 / Oracle Cloud (OCI) HeatWave Database Credentials
# If MYSQL_HOST is set, backend automatically uses MySQL 8.0 / OCI DB!
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=bookswap
MYSQL_SSL=false
